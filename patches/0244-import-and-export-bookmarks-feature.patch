+void BookmarkBridge::ImportBookmarks(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& j_window) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!bookmark_import_export_helper_ ||
+      bookmark_import_export_helper_->InProgress()) {
+    return;
+  }
+  bookmark_import_export_helper_->Import(j_window);
+}
+
+void BookmarkBridge::ExportBookmarks(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& j_window) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!bookmark_import_export_helper_ ||
+      bookmark_import_export_helper_->InProgress()) {
+    return;
+  }
+  bookmark_import_export_helper_->Export(j_window);
+}
+
