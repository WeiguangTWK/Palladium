 namespace extensions {
 
+namespace {
+
+bool CanUseBrowserForContext(BrowserWindowInterface* browser,
+                             content::BrowserContext* context) {
+  if (!browser || browser->IsDeleteScheduled()) {
+    return false;
+  }
+  Profile* const profile = Profile::FromBrowserContext(context);
+  Profile* const candidate_profile = browser->GetProfile();
+  return profile && candidate_profile &&
+         profile->IsSameOrParent(candidate_profile);
+}
+
+content::WebContents* FindTabWebContentsAcrossAllBrowsers(
+    content::BrowserContext* browser_context,
+    int tab_id) {
+  for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+    if (!CanUseBrowserForContext(browser, browser_context)) {
+      continue;
+    }
+    TabListInterface* tab_list = TabListInterface::From(browser);
+    if (!tab_list) {
+      continue;
+    }
+    for (int i = 0; i < tab_list->GetTabCount(); ++i) {
+      ::tabs::TabInterface* tab = tab_list->GetTab(i);
+      content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+      if (contents &&
+          sessions::SessionTabHelper::IdForTab(contents).id() == tab_id) {
+        return contents;
+      }
+    }
+  }
+  return nullptr;
+}
+
