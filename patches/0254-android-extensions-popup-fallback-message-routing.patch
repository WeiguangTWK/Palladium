+std::optional<int> GetActionFallbackOpenerTabId(content::WebContents* contents) {
+  if (!contents) {
+    return std::nullopt;
+  }
+
+  const GURL& url = contents->GetLastCommittedURL();
+  std::string marker;
+  if (!net::GetValueForKeyInQuery(url, kAndroidActionFallbackQueryKey,
+                                  &marker) ||
+      marker != "1") {
+    return std::nullopt;
+  }
+
+  const std::string ref(url.ref().data(), url.ref().size());
+  if (!base::StartsWith(ref, "tab")) {
+    return std::nullopt;
+  }
+
+  int tab_id = -1;
+  if (!base::StringToInt(ref.substr(3), &tab_id) || tab_id < 0) {
+    return std::nullopt;
+  }
+
+  return tab_id;
+}
+
+bool FindActionFallbackSourceTabAcrossAllBrowsers(
+    int tab_id,
+    BrowserWindowInterface** out_browser,
+    content::WebContents** out_contents,
+    int* out_tab_index) {
+  if (out_browser) {
+    *out_browser = nullptr;
+  }
+  if (out_contents) {
+    *out_contents = nullptr;
+  }
+  if (out_tab_index) {
+    *out_tab_index = api::tabs::TAB_INDEX_NONE;
+  }
+
+  for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+    if (!browser || browser->IsDeleteScheduled()) {
+      continue;
+    }
+    TabListInterface* tab_list = TabListInterface::From(browser);
+    if (!tab_list) {
+      continue;
+    }
+    for (int i = 0; i < tab_list->GetTabCount(); ++i) {
+      ::tabs::TabInterface* tab = tab_list->GetTab(i);
+      content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+      if (!contents ||
+          sessions::SessionTabHelper::IdForTab(contents).id() != tab_id) {
+        continue;
+      }
+      if (out_browser) {
+        *out_browser = browser;
+      }
+      if (out_contents) {
+        *out_contents = contents;
+      }
+      if (out_tab_index) {
+        *out_tab_index = i;
+      }
+      return true;
+    }
+  }
+  return false;
+}
+
+std::optional<int> GetActionFallbackOpenerTabIdForExtensionInBrowser(
+    BrowserWindowInterface* browser,
+    const Extension* extension) {
+  if (!browser || !extension) {
+    return std::nullopt;
+  }
+
+  TabListInterface* tab_list = TabListInterface::From(browser);
+  if (!tab_list) {
+    return std::nullopt;
+  }
+
+  ::tabs::TabInterface* active_tab = tab_list->GetActiveTab();
+  content::WebContents* contents = active_tab ? active_tab->GetContents()
+                                              : nullptr;
+  if (!contents) {
+    return std::nullopt;
+  }
+
+  const GURL& url = contents->GetLastCommittedURL();
+  if (!url.SchemeIs(extensions::kExtensionScheme) ||
+      url.host() != extension->id()) {
+    return std::nullopt;
+  }
+
+  return GetActionFallbackOpenerTabId(contents);
+}
+
+bool CanUseBroadLookupBrowserForProfile(BrowserWindowInterface* browser,
+                                        content::BrowserContext* context,
+                                        bool include_incognito_information) {
+  if (!browser) {
+    return false;
+  }
+  Profile* const profile = Profile::FromBrowserContext(context);
+  Profile* const candidate_profile = browser->GetProfile();
+  if (!profile || !candidate_profile ||
+      !profile->IsSameOrParent(candidate_profile)) {
+    return false;
+  }
+  return include_incognito_information || profile == candidate_profile;
+}
+
+bool ShouldDirectlyReturnActionFallbackSourceTab(
+    const tabs::Query::Params::QueryInfo& query_info) {
+  return query_info.active.value_or(false) &&
+         (query_info.current_window.value_or(false) ||
+          query_info.last_focused_window.value_or(false)) &&
+         !query_info.window_id.has_value() && !query_info.index.has_value() &&
+         !query_info.url &&
+         !query_info.highlighted.has_value() && !query_info.pinned.has_value() &&
+         !query_info.group_id.has_value() &&
+         !query_info.split_view_id.has_value() &&
+         !query_info.audible.has_value() && !query_info.frozen.has_value() &&
+         !query_info.discarded.has_value() &&
+         !query_info.auto_discardable.has_value() &&
+         !query_info.muted.has_value() && !query_info.title &&
+         query_info.status == tabs::TabStatus::kNone;
+}
+
+tabs::WindowType GetTabsWindowTypeForBrowser(
+    const BrowserWindowInterface* browser) {
+  CHECK(browser);
+  switch (browser->GetType()) {
+    case BrowserWindowInterface::TYPE_APP:
+      return tabs::WindowType::kApp;
+    case BrowserWindowInterface::TYPE_APP_POPUP:
+    case BrowserWindowInterface::TYPE_POPUP:
+      return tabs::WindowType::kPopup;
+#if BUILDFLAG(IS_ANDROID)
+    case BrowserWindowInterface::TYPE_CUSTOM_TAB:
+      return tabs::WindowType::kCustomTab;
+#endif
+#if !BUILDFLAG(IS_ANDROID)
+    case BrowserWindowInterface::TYPE_DEVTOOLS:
+      return tabs::WindowType::kDevtools;
+#endif
+    case BrowserWindowInterface::TYPE_NORMAL:
+#if !BUILDFLAG(IS_ANDROID)
+    case BrowserWindowInterface::TYPE_PICTURE_IN_PICTURE:
+#endif
+      return tabs::WindowType::kNormal;
+  }
+}
+
+bool MatchesActionFallbackSourceWindowType(
+    const tabs::Query::Params::QueryInfo& query_info,
+    BrowserWindowInterface* source_browser,
+    WindowController* source_window) {
+  if (query_info.window_type == tabs::WindowType::kNone) {
+    return true;
+  }
+  const std::string actual_type =
+      source_window
+          ? source_window->GetWindowTypeText()
+          : (source_browser ? tabs::ToString(GetTabsWindowTypeForBrowser(
+                                source_browser))
+                            : std::string());
+  return !actual_type.empty() &&
+         tabs::ToString(query_info.window_type) == actual_type;
+}
