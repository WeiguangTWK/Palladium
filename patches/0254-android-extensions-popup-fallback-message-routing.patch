+
+  if (source_contents->GetVisibility() == content::Visibility::VISIBLE) {
+    if (retries_remaining > 0) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(&MaybeUnfreezeAndroidPopupFallbackSource,
+                         std::move(source_contents), retries_remaining - 1));
+    }
+    return;
+  }
+
+  source_contents->SetPageFrozen(false);
+}
