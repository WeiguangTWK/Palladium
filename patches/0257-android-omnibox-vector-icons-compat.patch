From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenAI Codex <codex@openai.com>
Date: Fri, 15 May 2026 13:55:00 +0800
Subject: [PATCH] Adapt omnibox vector icon codepaths for Android builds

---
 .../ui/webui/cr_components/searchbox/searchbox_handler.cc |  5 +++++
 components/omnibox/browser/BUILD.gn                       |  2 +-
 components/omnibox/browser/autocomplete_match.cc          | 11 ++++++++---
 components/omnibox/browser/autocomplete_match.h           |  2 --
 4 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/ui/webui/cr_components/searchbox/searchbox_handler.cc b/chrome/browser/ui/webui/cr_components/searchbox/searchbox_handler.cc
index cd6f4f6567d91..dd9345d348170 100644
--- a/chrome/browser/ui/webui/cr_components/searchbox/searchbox_handler.cc
+++ b/chrome/browser/ui/webui/cr_components/searchbox/searchbox_handler.cc
@@ -901,7 +901,12 @@ SearchboxHandler::CreateAutocompleteMatch(
   for (const auto& action : match.actions) {
     std::string icon_path;
     if (action->GetIconImage().IsEmpty()) {
+#if defined(SUPPORT_PEDALS_VECTOR_ICONS)
       icon_path = AutocompleteIconToResourceName(action->GetVectorIcon());
+#else
+      icon_path =
+          AutocompleteIconToResourceName(omnibox::kProductChromeRefreshOldIcon);
+#endif
     } else {
       icon_path = webui::GetBitmapDataUrl(action->GetIconImage().AsBitmap());
     }
diff --git a/components/omnibox/browser/BUILD.gn b/components/omnibox/browser/BUILD.gn
index e85e14a26331f..56f7d584e3e50 100644
--- a/components/omnibox/browser/BUILD.gn
+++ b/components/omnibox/browser/BUILD.gn
@@ -441,7 +441,7 @@ static_library("browser") {
     ]
   }
 
-  if ((!is_android || enable_vr) && !is_ios) {
+  if (!is_ios) {
     deps += [ ":vector_icons" ]
   }
 
diff --git a/components/omnibox/browser/autocomplete_match.cc b/components/omnibox/browser/autocomplete_match.cc
index 08614e9f6dcee..e52f2fb58327c 100644
--- a/components/omnibox/browser/autocomplete_match.cc
+++ b/components/omnibox/browser/autocomplete_match.cc
@@ -58,11 +58,9 @@
 #include "url/third_party/mozilla/url_parse.h"
 #include "url/url_util.h"
 
-#if (!BUILDFLAG(IS_ANDROID) || BUILDFLAG(ENABLE_VR)) && !BUILDFLAG(IS_IOS)
 #include "components/omnibox/browser/suggestion_answer.h"
 #include "components/omnibox/browser/vector_icons.h"  // nogncheck
 #include "components/vector_icons/vector_icons.h"     // nogncheck
-#endif
 
 constexpr bool kIsDesktop = !BUILDFLAG(IS_ANDROID) && !BUILDFLAG(IS_IOS);
 constexpr bool kIsAndroid = BUILDFLAG(IS_ANDROID);
@@ -485,7 +483,6 @@ AutocompleteMatch& AutocompleteMatch::operator=(
   return *this;
 }
 
-#if (!BUILDFLAG(IS_ANDROID) || BUILDFLAG(ENABLE_VR)) && !BUILDFLAG(IS_IOS)
 // static
 const gfx::VectorIcon& AutocompleteMatch::AnswerTypeToAnswerIcon(
     omnibox::AnswerType type) {
@@ -572,8 +569,12 @@ const gfx::VectorIcon& AutocompleteMatch::GetVectorIcon(
                  : vector_icons::kSearchChromeRefreshOldIcon;
 
     case Type::PEDAL:
+#if defined(SUPPORT_PEDALS_VECTOR_ICONS)
       return takeover_action ? takeover_action->GetVectorIcon()
                              : vector_icons::kSearchChromeRefreshOldIcon;
+#else
+      return vector_icons::kSearchChromeRefreshOldIcon;
+#endif
 
     case Type::SEARCH_OTHER_ENGINE:
       if (provider != nullptr &&
@@ -692,7 +693,6 @@ const gfx::VectorIcon& AutocompleteMatch::GetVectorIcon(
       return omnibox::kPageChromeRefreshOldIcon;
   }
 }
-#endif
 
 // static
 bool AutocompleteMatch::MoreRelevant(const AutocompleteMatch& match1,
diff --git a/components/omnibox/browser/autocomplete_match.h b/components/omnibox/browser/autocomplete_match.h
index 733572b281968..d46bd8d84a114 100644
--- a/components/omnibox/browser/autocomplete_match.h
+++ b/components/omnibox/browser/autocomplete_match.h
@@ -354,7 +354,6 @@ struct AutocompleteMatch {
   void UpdateJavaDescription();
 #endif
 
-#if (!BUILDFLAG(IS_ANDROID) || BUILDFLAG(ENABLE_VR)) && !BUILDFLAG(IS_IOS)
   // Converts omnibox::AnswerType to an answer vector icon.
   static const gfx::VectorIcon& AnswerTypeToAnswerIcon(
       omnibox::AnswerType type);
@@ -371,7 +370,6 @@ struct AutocompleteMatch {
   // starter pack suggestion (e.g. @tabs, @history, @bookmarks, etc.).
   const gfx::VectorIcon& GetVectorIcon(bool is_bookmark,
                                        const TemplateURL* turl = nullptr) const;
-#endif
 
   // Comparison function for determining whether the first match is better than
   // the second.
