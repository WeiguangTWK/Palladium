+std::optional<int> GetActionFallbackOpenerTabId(content::WebContents* contents) {
+  if (!contents) {
+    return std::nullopt;
+  }
+
+  const GURL& url = contents->GetLastCommittedURL();
+  std::string marker;
+  if (!net::GetValueForKeyInQuery(url, kAndroidActionFallbackQueryKey,
+                                  &marker) ||
+      marker != "1") {
+    return std::nullopt;
+  }
+
+  const std::string ref(url.ref().data(), url.ref().size());
+  if (!base::StartsWith(ref, "tab")) {
+    return std::nullopt;
+  }
+
+  int tab_id = -1;
+  if (!base::StringToInt(ref.substr(3), &tab_id) || tab_id < 0) {
+    return std::nullopt;
+  }
+
+  return tab_id;
+}
+
+std::string SummarizeTabDebugUrl(const GURL& url) {
+  return base::StrCat({url.scheme(), "://", url.host(),
+                       url.has_query() ? "?" : "",
+                       url.has_query() ? std::string(url.query()) : "",
+                       url.has_ref() ? "#" : "",
+                       url.has_ref() ? std::string(url.ref()) : ""});
+}
+
+bool FindActionFallbackSourceTabAcrossAllBrowsers(
+    int tab_id,
+    BrowserWindowInterface** out_browser,
+    content::WebContents** out_contents,
+    int* out_tab_index) {
+  if (out_browser) {
+    *out_browser = nullptr;
+  }
+  if (out_contents) {
+    *out_contents = nullptr;
+  }
+  if (out_tab_index) {
+    *out_tab_index = api::tabs::TAB_INDEX_NONE;
+  }
+
+  for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+    if (!browser || browser->IsDeleteScheduled()) {
+      continue;
+    }
+    TabListInterface* tab_list = TabListInterface::From(browser);
+    if (!tab_list) {
+      continue;
+    }
+    for (int i = 0; i < tab_list->GetTabCount(); ++i) {
+      ::tabs::TabInterface* tab = tab_list->GetTab(i);
+      content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+      if (!contents ||
+          sessions::SessionTabHelper::IdForTab(contents).id() != tab_id) {
+        continue;
+      }
+      if (out_browser) {
+        *out_browser = browser;
+      }
+      if (out_contents) {
+        *out_contents = contents;
+      }
+      if (out_tab_index) {
+        *out_tab_index = i;
+      }
+      return true;
+    }
+  }
+  return false;
+}
+
+bool CanUseBroadLookupBrowserForProfile(BrowserWindowInterface* browser,
+                                        content::BrowserContext* context,
+                                        bool include_incognito_information) {
+  if (!browser) {
+    return false;
+  }
+  Profile* const profile = Profile::FromBrowserContext(context);
+  Profile* const candidate_profile = browser->GetProfile();
+  if (!profile || !candidate_profile ||
+      !profile->IsSameOrParent(candidate_profile)) {
+    return false;
+  }
+  return include_incognito_information || profile == candidate_profile;
+}
+
+bool ShouldDirectlyReturnActionFallbackSourceTab(
+    const tabs::Query::Params::QueryInfo& query_info) {
+  return query_info.active.value_or(false) &&
+         (query_info.current_window.value_or(false) ||
+          query_info.last_focused_window.value_or(false)) &&
+         !query_info.window_id.has_value() && !query_info.index.has_value() &&
+         query_info.window_type == tabs::WindowType::kNone &&
+         !query_info.url &&
+         !query_info.highlighted.has_value() && !query_info.pinned.has_value() &&
+         !query_info.group_id.has_value() &&
+         !query_info.split_view_id.has_value() &&
+         !query_info.audible.has_value() && !query_info.frozen.has_value() &&
+         !query_info.discarded.has_value() &&
+         !query_info.auto_discardable.has_value() &&
+         !query_info.muted.has_value() && !query_info.title &&
+         query_info.status == tabs::TabStatus::kNone;
+}
+
+bool ShouldDirectlyReturnActionFallbackCallerTab(
+    const tabs::Query::Params::QueryInfo& query_info) {
+  return query_info.active.value_or(false) &&
